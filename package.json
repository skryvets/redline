{
  "name": "redline",
  "version": "0.2.0",
  "description": "A review-first video editor. You leave notes on the timeline, Claude Code makes the edit",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test lib/",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.skryvets.redline",
    "productName": "Redline",
    "files": [
      "main.js",
      "preload.js",
      "editor-guide.md",
      "lib/core.js",
      "lib/update.js",
      "ui/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
